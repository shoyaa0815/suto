$black: #000000;
$foreground: #e4e4e7;
$muted: #71717a;
$accent: #3b82f6;

Screen {
    background: $black;
    color: $foreground;
}

#shell {
    width: 100%;
    height: 100%;
    padding: 1 2 0 2;
    background: $black;
}

#brand {
    width: 100%;
    height: 5;
    background: $black;
}

#terminal {
    width: 100%;
    height: 1fr;
    padding: 1 0;
    background: $black;
    color: $foreground;
    border: none;
    scrollbar-background: $black;
    scrollbar-background-hover: $black;
    scrollbar-background-active: $black;
    scrollbar-color: #27272a;
    scrollbar-color-hover: #3f3f46;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $black;
}

#prompt-row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    background: $black;
}

#prompt-marker {
    width: 3;
    height: 3;
    padding: 1 0 0 1;
    background: $black;
    color: #d4d4d8;
    text-style: bold;
}

#prompt {
    width: 1fr;
    height: 3;
    padding: 1 1 0 1;
    background: #18181b;
    color: $foreground;
    border: none;
}

#prompt:focus {
    border: none;
    background: #27272a;
    background-tint: transparent;
}

#prompt > .input--placeholder {
    color: #a1a1aa;
}

#prompt > .input--cursor {
    background: $foreground;
    color: $black;
}

#prompt > .input--selection {
    background: #52525b;
}

#status-bar {
    width: 100%;
    height: 1;
    background: $black;
    color: $muted;
}

SettingsScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#settings-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: #18181b;
    border: solid $accent;
}

#settings-title {
    width: 100%;
    height: 2;
    color: #f4f4f5;
    text-style: bold;
}

#settings-timezone-label {
    width: 100%;
    height: 1;
    color: #d4d4d8;
}

#settings-timezone {
    width: 100%;
    margin-top: 1;
    background: #27272a;
    color: $foreground;
    border: none;
}

#settings-timezone:focus {
    border: none;
    background: #3f3f46;
}

#settings-error {
    width: 100%;
    height: 2;
    padding-top: 1;
    color: #f87171;
}

#settings-actions {
    width: 100%;
    height: 3;
    align-horizontal: right;
}

#settings-actions Button {
    min-width: 12;
    margin-left: 1;
}
